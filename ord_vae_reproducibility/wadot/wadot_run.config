params {
  kfold = 5
  input_data = '/mnt/mr01-data01/j72687wm/ordVae_paper/datasets/wadot/h5'
  processed_h5ad = "wadot_processed.h5ad"
  processed_seurat = "wadot_processed.rds"
  dataset_base = 'wadot'
  outdir = '/mnt/mr01-data01/j72687wm/ordVae_paper/nextflow_wadot/results'
  reuse_existing = true
}

workDir = '/mnt/mr01-data01/j72687wm/ordVae_paper/nextflow_wadot/work'
conda.enabled = true
conda.useMamba = true

report {
  overwrite = true
}

dag {
  overwrite = true
}

// Special config scope (no commas between lines)
process {
  executor = 'slurm'
  errorStrategy = 'finish'
  maxRetries = 0
}

trace {
  fields = 'task_id,process,tag,status,exit,native_id,cpus,memory,rss,%cpu,duration,realtime,workdir'
}

// plotting params
params.plotting = [
    method_colours: [
        'ga_cumulative_logit': 0,
        'ga_ord': 2,
        'ga_reg': 4,
        'nb_reg': 6,
        'nb_ord': 8,
        'nb_cumulative_logit': 10,
        'pypsupertime': 12,
        'temporalVAE': 14,
        'raptor': 16,
        'sceptic': 18
    ],
    colormap: 'tab20'
]

// User params (regular Groovy Map with commas)
// dictionary of analysis methods and their metadata (scripts located in bin)
params.methods = [
    ga_cumulative_logit: [
        script: 'bin/run_method/run_rna_vae_ga_cum_logit.py',
        language: 'python',
        gpu: true,
        conda_env: 'lightning_2',
        time: '96h', 
        time_col_suffix: '',
        allowed_experiments: ['in_dist', 'out_dist', 'all_train']
    ],
    ga_ord: [
        script: 'bin/run_method/run_rna_vae_ga_ord.py',
        language: 'python',
        gpu: true,
        conda_env: 'lightning_2',
        time: '96h', 
        time_col_suffix: '',
        allowed_experiments: ['in_dist', 'out_dist', 'all_train']
    ],
    ga_reg: [
        script: 'bin/run_method/run_rna_vae_ga_reg.py',
        language: 'python',
        gpu: true,
        conda_env: 'lightning_2',
        time: '96h', 
        time_col_suffix: '_mean',
        allowed_experiments: ['in_dist', 'out_dist', 'all_train']
    ],
    nb_ord: [
        script: 'bin/run_method/run_rna_vae_nb_ord.py',
        language: 'python',
        gpu: true,
        time: '96h', 
        conda_env: 'lightning_2',
        time_col_suffix: '',
        allowed_experiments: ['in_dist', 'out_dist', 'all_train']
    ],
    nb_reg: [
        script: 'bin/run_method/run_rna_vae_nb_reg.py',
        language: 'python',
        gpu: true,
        conda_env: 'lightning_2',
        time: '96h', 
        time_col_suffix: '_mean',
        allowed_experiments: ['in_dist', 'out_dist', 'all_train']
    ],
    nb_cumulative_logit: [
        script: 'bin/run_method/run_rna_vae_nb_cum_logit.py',
        language: 'python',
        gpu: true,
        conda_env: 'lightning_2',
        time: '96h', 
        time_col_suffix: '',
        allowed_experiments: ['in_dist', 'out_dist', 'all_train']
    ],
    pypsupertime: [
        script: 'bin/run_method/run_pypsupertime.py',
        language: 'python',
        gpu: false,
        conda_env: 'lightning_2',
        time_col_suffix: '_mean',
        allowed_experiments: ['in_dist', 'out_dist', 'all_train'],
        cpus: 64,
        memory: '512 GB',
        time: '168h', 
        n_jobs: 4    // Only spawns 4 worker processes to save memory (prevent sigfault)
    ],
    // retro: [
    //     script: 'bin/run_method/run_retro.R',
    //     language: 'Rscript',
    //     gpu: false,
    //     conda_env: 'r_RETRO',
    //     time_col_suffix: '_mean',
    //     allowed_experiments: ['all_train']
    // ],
    sceptic: [
        script: 'bin/run_method/run_sceptic.py',
        language: 'python',
        gpu: false,
        conda_env: 'lightning_2',
        time_col_suffix: '_mean',
        time: '168h',
        mode: 'xgboost',
        cpus: 64,
        memory: '512 GB',
        allowed_experiments: ['in_dist', 'out_dist', 'all_train']
    ],
    temporalVAE: [
        script: 'bin/run_method/run_temporalVAE.py',
        language: 'python',
        gpu: true,
        conda_env: 'temporal_vae',
        time: '96h', 
        extra_pythonpath: '/mnt/mr01-data01/j72687wm/ordVae_paper/temporal_vae_benchmark/TemporalVAE',
        time_col_suffix: '_mean',
        allowed_experiments: ['in_dist', 'out_dist', 'all_train']
    ]
    // ga_continuation_ratio: [
    //     script: 'bin/run_method/run_ga_continuation_ratio.py',
    //     language: 'python',
    //     gpu: true,
    //     conda_env: 'lightning_2',
    //     cpus : 4, memory : '16 GB', time : '08:00:00',
    //     time_col_suffix: '',
    //     allowed_experiments: ['in_dist', 'out_dist', 'all_train']

    // ],
]

params.experiment = [
    in_dist: [
        split_col: 'in_dist_split',
        train_col: ['windowed_day_exp1', 'windowed_day_exp2', 'windowed_day_exp3'],
        metrics: ['pearson', 'kendall', 'spearman', 'mse', 'accuracy']  // options 'mse', 'accuracy', 'pearson', 'kendall', 'spearman'

    ],
    out_dist: [
        split_col: '',
        train_col: ['windowed_day_exp1', 'windowed_day_exp2', 'windowed_day_exp3'],
        metrics: ['mse', 'accuracy']  // options 'mse', 'accuracy', 'pearson', 'kendall', 'spearman']
    ],
    all_train: [
        split_col: '',
        train_col: ['windowed_day_exp1', 'windowed_day_exp2', 'windowed_day_exp3'],
        metrics: ['pearson', 'kendall', 'spearman', 'mse', 'accuracy']  // options 'mse', 'accuracy', 'pearson', 'kendall', 'spearman']
    ]
]
params {
  input_data = "/mnt/mr01-data01/j72687wm/ordVae_paper/datasets/mouse_embryo/adata_JAX_dataset_1.h5ad"
  processed_h5ad = "mouse_embryo_processed_test.h5ad"
  dataset_base = "mouse_embryo_test"
  outdir = "/mnt/mr01-data01/j72687wm/ordVae_paper/nextflow_mouse/results_test"
  test = true
  reuse_existing = false
}

workDir = "/mnt/mr01-data01/j72687wm/ordVae_paper/nextflow_mouse/work_test"
conda.enabled = true
conda.useMamba = true

report {
  overwrite = true
}

dag {
  overwrite = true
}

// Special config scope (no commas between lines)
process {
  executor = 'slurm'
  errorStrategy = 'finish'
  maxRetries = 0
}

trace {
  fields = 'task_id,process,tag,status,exit,native_id,cpus,memory,rss,%cpu,duration,realtime,workdir'
}

// User params (regular Groovy Map with commas)
// dictionary of analysis methods and their metadata (scripts located in bin)
params.methods = [
    // ga_continuation_ratio: [
    //     script: 'bin/run_method/run_ga_continuation_ratio.py',
    //     language: 'python',
    //     gpu: true,
    //     conda_env: 'lightning_2',
    //     cpus : 4, memory : '16 GB', time : '08:00:00',
    //     time_col_suffix: '',
    //     allowed_experiments: ['in_dist', 'out_dist', 'all_train']

    // ],
    ga_cumulative_logit: [
        script: 'bin/run_method/run_rna_vae_ga_cum_logit.py',
        language: 'python',
        gpu: true,
        cpus: 8,
        conda_env: 'lightning_2',
        time_col_suffix: '',
        allowed_experiments: ['test_train']
    ],
    ga_ord: [
        script: 'bin/run_method/run_rna_vae_ga_ord.py',
        language: 'python',
        gpu: true,
        cpus: 8,
        conda_env: 'lightning_2',
        time: '48:00:00', 
        time_col_suffix: '',
        allowed_experiments: ['test_train']
    ],
    ga_reg: [
        script: 'bin/run_method/run_rna_vae_ga_reg.py',
        language: 'python',
        gpu: true,
        cpus: 8,
        conda_env: 'lightning_2',
        time_col_suffix: '_mean',
        allowed_experiments: ['test_train']
    ],
    nb_ord: [
        script: 'bin/run_method/run_rna_vae_nb_ord.py',
        language: 'python',
        gpu: true,
        time: '12:00:00', 
        cpus: 8,
        conda_env: 'lightning_2',
        time_col_suffix: '',
        allowed_experiments: ['test_train']
    ],
    nb_reg: [
        script: 'bin/run_method/run_rna_vae_nb_reg.py',
        language: 'python',
        gpu: true,
        cpus: 8,
        conda_env: 'lightning_2',
        time_col_suffix: '_mean',
        allowed_experiments: ['in_dist', 'out_dist', 'all_train']
    ],
    nb_cumulative_logit: [
        script: 'bin/run_method/run_rna_vae_nb_cum_logit.py',
        language: 'python',
        gpu: true,
        cpus: 8,
        conda_env: 'lightning_2',
        time_col_suffix: '',
        allowed_experiments: ['test_train']
    ],
    pypsupertime: [
        script: 'bin/run_method/run_pypsupertime.py',
        language: 'python',
        gpu: false,
        conda_env: 'lightning_2',
        time_col_suffix: '_mean',
        allowed_experiments: ['test_train'],
        cpus: 16,
        memory: '128 GB',
        time: '12:00:00', 
        n_jobs: 4    // Only spawns 4 worker processes to save memory (prevent sigfault)
    ],
    // retro: [
    //     script: 'bin/run_method/run_retro.R',
    //     language: 'Rscript',
    //     gpu: false,
    //     conda_env: 'r_RETRO',
    //     time_col_suffix: '_mean',
    //     allowed_experiments: ['all_train']
    // ],
    sceptic: [
        script: 'bin/run_method/run_sceptic.py',
        language: 'python',
        gpu: true,
        conda_env: 'lightning_2',
        time_col_suffix: '_mean',
        cpus: 12,
        memory: '96 GB',
        time: '12:00:00',
        mode: 'xgboost',
        allowed_experiments: ['test_train']
    ],
    temporalVAE: [
        script: 'bin/run_method/run_temporalVAE.py',
        language: 'python',
        gpu: true,
        cpus: 8,
        memory: '64 GB',
        conda_env: 'temporal_vae',
        extra_pythonpath: '/mnt/mr01-data01/j72687wm/ordVae_paper/temporal_vae_benchmark/TemporalVAE',
        time_col_suffix: '_mean',
        allowed_experiments: ['test_train']
    ]
]

params.experiment = [
    test_train: [
        split_col: 'test_train',
        train_col: ['windowed_day_base', 'windowed_day_coarsened', 'windowed_day_overlapping'],
        metrics: ['pearson', 'kendall', 'spearman', 'mse', 'accuracy']  // options 'mse', 'accuracy', 'pearson', 'kendall', 'spearman'
    ]
]

// Plotting parameters
params.plotting = [
    method_colours: [
        'ga_cumulative_logit': 0,
        'ga_ord': 2,
        'ga_reg': 4,
        'nb_reg': 6,
        'nb_ord': 8,
        'nb_cumulative_logit': 10,
        'pypsupertime': 12,
        'temporalVAE': 14,
        'raptor': 16,
        'sceptic': 18
    ],
    colormap: 'tab20'
]